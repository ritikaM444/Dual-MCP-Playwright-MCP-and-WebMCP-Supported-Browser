# Copy to .env and fill in. Never commit .env.

# Which LLM backend: omniroute | gemini | anthropic
#   omniroute -- local gateway, auto-falls-back across many free providers
#                so one provider's rate limit can't kill a live demo.
#                Start it separately:  omniroute   (see README)
#   gemini    -- direct Google (free key: aistudio.google.com/apikey)
#   anthropic -- direct Claude (needs billing)
LLM_PROVIDER=omniroute

# --- omniroute / any OpenAI-compatible endpoint ---
OPENAI_BASE_URL=http://localhost:20128/v1
OPENAI_MODEL=auto
# OmniRoute needs no key; leave this placeholder as-is.
OPENAI_API_KEY=omniroute-local

# --- gemini ---
GEMINI_API_KEY=
# Flash-Lite gives ~500 free requests/day; full Flash models only ~20.
GEMINI_MODEL=gemini-3.5-flash-lite

# --- anthropic ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Demo mode: watch the browser work ---
HEADLESS=false
SLOW_MO=500

DEMO_BASE_URL=http://localhost:4173
WEBAPP_PORT=8000
# AGENT_MAX_STEPS=15
